{
  "name": "backend-langgraph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/assets dist/assets",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:shopping": "tsx src/db/seed-shopping.ts",
    "lint": "eslint src",
    "test": "jest --testPathPattern='tests/unit'",
    "test:integration": "jest --testPathPattern='tests/integration'",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testPathPattern='tests/unit'"
  },
  "dependencies": {
    "@duffel/api": "^4.25.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "lru-cache": "^5.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.0",
    "pino-pretty": "^13.1.3",
    "tsdav": "^2.2.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/lru-cache": "^7.10.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
