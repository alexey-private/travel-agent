{
  "name": "backend-langgraph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/assets dist/assets && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "seed": "tsx src/db/seed.ts",
    "seed:shopping": "tsx src/db/seed-shopping.ts",
    "lint": "eslint src",
    "test": "jest --testPathPatterns='tests/unit'",
    "test:integration": "jest --testPathPatterns='tests/integration'",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testPathPatterns='tests/unit'"
  },
  "dependencies": {
    "@duffel/api": "^4.28.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@langchain/anthropic": "^1.5.8",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/openai": "^1.5.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "googleapis": "^176.0.0",
    "lru-cache": "^11.5.2",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "tsdav": "^2.2.2",
    "web-push": "^3.6.7",
    "world-countries": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
