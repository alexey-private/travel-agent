# Database
DATABASE_URL=postgresql://user:password@localhost:5432/travel_agent
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/travel_agent_test

# AI
# LLM provider: anthropic | openai (default: anthropic)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# External Tools
TAVILY_API_KEY=tvly-...
OPENWEATHER_API_KEY=...
VOYAGE_API_KEY=...

# Amadeus (optional — enables search_flights tool)
AMADEUS_API_KEY=...
AMADEUS_API_SECRET=...

# Server
PORT=3001
NODE_ENV=development

# Google OAuth2 (optional — enables Google Calendar/Tasks)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# iCloud credentials encryption key (32+ chars recommended)
ENCRYPTION_KEY=change-this-to-a-long-random-secret-key-32ch

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
