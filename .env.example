# Database
DATABASE_URL=postgresql://user:password@localhost:5432/travel_agent
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/travel_agent_test

# AI
# LLM provider: anthropic | openai (default: anthropic)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Not only the Whisper key. It is also the standby the automatic fallback below
# answers from, so a deployment that drops it as "the transcription key" silently
# loses the fallback as well.
OPENAI_API_KEY=sk-...

# Model ids. REASONING_MODEL / FAST_MODEL mean "the model the ACTIVE provider
# uses" — what they have always meant. The per-provider pairs win over them and
# are what a standby reads, so a fallback never asks OpenAI for a Claude model.
# All six are optional; unset falls back to the built-in default per provider.
# REASONING_MODEL=
# FAST_MODEL=
# ANTHROPIC_REASONING_MODEL=claude-sonnet-4-6
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# OPENAI_REASONING_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini

# Automatic provider fallback: when the active provider errors, the same call is
# retried on the other one — no env edit, no restart. Needs both API keys; with
# only one set there is no standby and nothing changes.
# 'false' is the kill switch and restores the previous behaviour exactly.
LLM_FALLBACK_ENABLED=true
# How long the standby keeps answering before the primary is probed again.
# 0 retries the primary on every request.
LLM_FALLBACK_COOLDOWN_MS=300000

# External Tools
TAVILY_API_KEY=tvly-...
OPENWEATHER_API_KEY=...
VOYAGE_API_KEY=...

# Amadeus (optional — enables search_flights tool)
AMADEUS_API_KEY=...
AMADEUS_API_SECRET=...

# Server
PORT=3002
NODE_ENV=development
# Browser origins allowed to read this API, comma-separated. Required when
# NODE_ENV=production; left unset, localhost on any port is allowed instead.
ALLOWED_ORIGIN=

# Google OAuth2 (optional — enables Google Calendar/Tasks)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/auth/google/callback

# iCloud credentials encryption key (32+ chars recommended)
ENCRYPTION_KEY=change-this-to-a-long-random-secret-key-32ch

# Shared with backend-telegram — must be the SAME value on both services.
# A Telegram session id (tg-<telegram user id>) is derived from a public number,
# so it cannot protect its own data the way a random web session id does; this
# secret is what makes those ids addressable by the bot alone. Unset means every
# Telegram-scoped request is refused (503) and /connect stops working.
INTERNAL_API_SECRET=change-this-to-a-long-random-shared-secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3002
