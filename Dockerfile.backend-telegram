# Build context must be the repo root (npm workspaces monorepo).
# Railway service config: set "Root Directory" to "/" and Dockerfile Path to
# "Dockerfile.backend-telegram". This service runs grammY long-polling
# (bot.start()) — no public port/domain needed.

FROM node:20-alpine AS base
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY backend-langgraph/package.json ./backend-langgraph/package.json
COPY backend-telegram/package.json ./backend-telegram/package.json
COPY frontend/package.json ./frontend/package.json

FROM base AS deps
RUN npm ci

FROM deps AS build
COPY tsconfig.base.json ./
COPY backend-telegram ./backend-telegram
RUN npm run build --workspace=backend-telegram

FROM base AS runtime
ENV NODE_ENV=production
RUN npm ci --omit=dev
COPY --from=build /app/backend-telegram/dist ./backend-telegram/dist
WORKDIR /app/backend-telegram

CMD ["node", "dist/index.js"]
