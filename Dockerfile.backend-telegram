# Build context must be the repo root (npm workspaces monorepo).
# Railway service config: set "Root Directory" to "/" and Dockerfile Path to
# "Dockerfile.backend-telegram". This service runs grammY long-polling
# (bot.start()) — no public port/domain needed.

FROM node:22-alpine AS base
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY backend-langgraph/package.json ./backend-langgraph/package.json
COPY backend-telegram/package.json ./backend-telegram/package.json
COPY frontend/package.json ./frontend/package.json
# The shared i18n package is copied whole, not just its package.json: the root
# `postinstall` compiles it, so its sources must be here before `npm ci` runs.
COPY shared ./shared

FROM base AS deps
RUN npm ci

FROM deps AS build
COPY backend-telegram ./backend-telegram
RUN npm run build --workspace=backend-telegram

FROM base AS runtime
ENV NODE_ENV=production
# --ignore-scripts skips the root `postinstall`, which would try to compile the
# shared package with a TypeScript that --omit=dev just left out. Its build
# output is copied from the build stage instead. No production dependency of
# this service declares an install script.
RUN npm ci --omit=dev --ignore-scripts
COPY --from=build /app/shared/i18n/dist ./shared/i18n/dist
COPY --from=build /app/backend-telegram/dist ./backend-telegram/dist
WORKDIR /app/backend-telegram

CMD ["node", "dist/index.js"]
