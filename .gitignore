# Build outputs
dist/
build/
.next/
out/
# Generated by `next dev`, `next build` and `next typegen`, and its contents
# differ between them — it referenced `.next/dev/types` or `.next/types`
# depending on which ran last, so tracking it meant a permanent phantom diff.
# Next's own docs say to ignore it and untrack it.
next-env.d.ts

