{
  "name": "backend-telegram",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "tsc -p ../shared/i18n/tsconfig.json",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretypecheck": "tsc -p ../shared/i18n/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathPatterns='tests/(?!integration)' --forceExit",
    "test:integration": "jest --testPathPatterns='tests/integration' --forceExit",
    "pretest:all": "tsc -p ../shared/i18n/tsconfig.json",
    "test:all": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit"
  },
  "dependencies": {
    "@travel-agent/i18n": "*",
    "@types/node-cron": "^3.0.11",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
