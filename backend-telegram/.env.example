BOT_TOKEN=your_telegram_bot_token_from_botfather
BACKEND_URL=http://localhost:3002
BACKEND_PUBLIC_URL=http://localhost:3002  # Publicly reachable backend URL for links sent to users (e.g. /connect); defaults to BACKEND_URL if unset. In production these must differ if BACKEND_URL is a private-network address (see DEPLOYMENT.md).
OPENAI_API_KEY=sk-...              # Required for voice message transcription (Whisper)
OPENWEATHER_API_KEY=your_key_here  # Required for location reverse-geocoding
NOTIFY_HOUR=9                      # Hour (0-23) to send daily calendar reminders

# Shared with backend-langgraph — must be the SAME value on both services.
# A Telegram session id (tg-<telegram user id>) is derived from a public number,
# so it cannot protect its own data the way a random web session id does; this
# secret is what makes those ids addressable by the bot alone. Unset means every
# Telegram-scoped request is refused (503) and /connect stops working.
INTERNAL_API_SECRET=change-this-to-a-long-random-shared-secret
